<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox off for distribution outside the Mac App Store -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- JIT needed for Flutter debug -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Outbound HTTPS to api.framefloww.me and S3 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Optional local server (unused for YouTube; website handles connect) -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- File-picker: read any user-chosen folder -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Allow reading from Downloads (common video storage) -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Allow reading from arbitrary absolute paths (external drives, NAS, etc.) -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<true/>
	<!-- Persist login cookies via flutter_secure_storage -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.sandybro.bulky</string>
	</array>
</dict>
</plist>
